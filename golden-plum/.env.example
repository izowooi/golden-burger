# Live only. Keep real values in Jenkins Credentials Binding or an untracked .env.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1

LOG_LEVEL=INFO
POLYBOT_LIFECYCLE_MODE=active
# RuntimeSpec freezes King/Queen/Silver=soccer and Gold=mlb. This key is shown
# only so an accidental mismatch fails closed; it is not a free switch.
POLYBOT_SPORT_FAMILY=soccer
POLYBOT_BUY_AMOUNT=5
POLYBOT_MIN_LIQUIDITY=5000
POLYBOT_MIN_CUMULATIVE_VOLUME=5000
POLYBOT_MIN_VOLUME_24H=0
POLYBOT_MAX_POSITIONS=10
POLYBOT_MAX_EVENT_POSITIONS=1
POLYBOT_MAX_NEW_POSITIONS_PER_CYCLE=5
POLYBOT_MAX_EMERGENCY_SELLS_PER_CYCLE=10
POLYBOT_YES_ONLY=false
POLYBOT_DRAWDOWN_LOSS_LIMIT_USDC=300

POLYBOT_ENTRY_PROB_MIN=0.70
POLYBOT_ENTRY_PROB_MAX=0.73
POLYBOT_MIN_SOURCE_MINUTE=0
POLYBOT_MAX_SOURCE_MINUTE=60
POLYBOT_TREND_OBSERVATIONS=1
POLYBOT_TREND_MIN_CUMULATIVE_MOVE=0.0
POLYBOT_TREND_MAX_PULLBACK=0.0
POLYBOT_TREND_MAX_GAP_SECONDS=90
POLYBOT_MIN_LEADER_MARGIN=0.005
POLYBOT_MAX_ENTRY_SPREAD=0.05
# Soccer live: King=0.85, Queen=0.90. Research/close-only runtimes keep their own values.
POLYBOT_TAKE_PROFIT_PRICE=0.85
POLYBOT_STOP_LOSS_DELTA=0.12
POLYBOT_FORCE_EXIT_MINUTE=65
POLYBOT_STOP_SELL_QUARANTINE_TIMEOUT_MINUTES=180

POLYBOT_EXPERIMENT_START_UTC=2026-08-31T00:00:00Z
POLYBOT_EXPERIMENT_END_UTC=9999-12-31T23:59:59Z
POLYBOT_EXPERIMENT_FOLLOWUP_END_UTC=9999-12-31T23:59:59Z
