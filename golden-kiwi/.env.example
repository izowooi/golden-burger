# Golden Kiwi is research/simulation-only and needs no wallet credentials.
# Never add POLYMARKET_PRIVATE_KEY or POLYMARKET_FUNDER_ADDRESS to this file.

# Frozen A/B/C/D treatment axes. Valid pairs:
# A=3/0.01, B=3/0.02 (primary), C=5/0.01, D=5/0.02.
POLYBOT_CONFIRMATION_STEPS=3
POLYBOT_MIN_CUMULATIVE_MOVE=0.02

# Promotion collection is enabled only when all three values are non-empty.
# Keep all three empty for smoke/archive verification. Before a real 30-day
# collection, use the preregistered shared interval
# [2026-08-13T00:00:00Z, 2026-09-12T00:00:00Z) and assign each canonical
# Jenkins job its fixed offset: A/B/C/D = 0/1/2/3.
POLYBOT_EXPERIMENT_START_UTC=
POLYBOT_EXPERIMENT_END_UTC=
POLYBOT_CADENCE_OFFSET_MINUTE=

# Gamma request filters and fail-closed budgets are code-frozen at liquidity
# 20k, cumulative volume 10k, 53 pages, 5,330 markets and 120 seconds. They do
# not need Jenkins environment variables.

# Operational lifecycle control; this does not alter an experiment arm.
# active: archive + simulated entries/exits
# close_only: archive + manage existing simulated positions
# archive_only: archive only
POLYBOT_LIFECYCLE_MODE=active
