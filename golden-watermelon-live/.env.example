# Secrets: keep real values only in an untracked .env or Jenkins Credentials Binding.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# Account-specific signing scheme: 1=proxy/Magic.Link, 3=POLY_1271.
POLYMARKET_SIGNATURE_TYPE=1

# Lifecycle and frozen Golden Watermelon Live baseline.
POLYBOT_LIFECYCLE_MODE=active
POLYBOT_BUY_AMOUNT=5
POLYBOT_MIN_LIQUIDITY=0
POLYBOT_MIN_VOLUME_24H=0
POLYBOT_MIN_CUMULATIVE_VOLUME=0
POLYBOT_REENTRY_COOLDOWN_HOURS=720
POLYBOT_MAX_SNAPSHOT_GAP_MINUTES=15
POLYBOT_MIN_ORDER_SIZE=5
POLYBOT_MIN_ORDER_BUFFER_SHARES=0
POLYBOT_YES_ONLY=true
POLYBOT_EXCLUDED_CATEGORIES=
POLYBOT_ENTRY_PROB_MIN=0.98
POLYBOT_ENTRY_PROB_MAX=0.999
POLYBOT_ENTRY_HOURS_MIN=0
POLYBOT_ENTRY_HOURS_MAX=4
POLYBOT_STOP_PRICE=0.70
POLYBOT_MAX_POSITIONS=20
POLYBOT_MAX_EVENT_POSITIONS=1
POLYBOT_MAX_NEW_POSITIONS_PER_CYCLE=20
POLYBOT_ARCHIVE_PROB_MIN=0
POLYBOT_ARCHIVE_HOURS_MAX=4
POLYBOT_SNAPSHOT_RETENTION_DAYS=60
POLYBOT_EXPERIMENT_START_UTC=2026-08-24T13:00:00Z
POLYBOT_EXPERIMENT_END_UTC=2026-08-31T13:00:00Z
POLYBOT_EXPERIMENT_FOLLOWUP_END_UTC=2026-09-07T13:00:00Z

LOG_LEVEL=INFO
