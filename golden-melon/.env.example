# Secrets: keep real values only in an untracked .env or Jenkins Credentials Binding.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# Account-specific signing scheme: 1=proxy/Magic.Link, 3=POLY_1271.
POLYMARKET_SIGNATURE_TYPE=1

# 사전 등록 롤아웃 금액. $5는 선호가 아니라 하한이다 —
# CLOB 최소 주문이 5.0 shares라 $1은 1.1주가 되어 전량 거절된다.
POLYBOT_BUY_AMOUNT=5

# ── A/B/C 처치축: 24시간 거래량 gate (이 전략의 전부) ──────────
#   A polybot-melon-low   20000
#   B polybot-melon-mid   50000   (기본)
#   C polybot-melon-high  150000
# POLYBOT_MIN_VOLUME_24H=50000

# ── 사전 등록 kill switch (코드가 강제) ────────────────────────
# 경제손익이 capital x drawdown 이하가 되면 신규 진입 중단. 3팔 동일하게 100.
POLYBOT_EXPERIMENT_CAPITAL_USDC=100
# POLYBOT_MAX_DRAWDOWN_STOP=0.20

# A/B/C 동안 아래는 override하지 않는다 (전 팔 동일해야 한다).
# POLYBOT_ENTRY_HOURS_MAX=72
# POLYBOT_ENTRY_PROB_MIN=0.85
# POLYBOT_ENTRY_PROB_MAX=0.93
# POLYBOT_TAKE_PROFIT_PRICE=0.97
# POLYBOT_STOP_PRICE=0.78
# POLYBOT_MIN_LIQUIDITY=20000
# POLYBOT_MAX_POSITIONS=20

# melon의 처치축이 아니다. quince가 별도로 검정 중이므로 nearest 고정.
# POLYBOT_EXECUTION_MODE=nearest

# Exceptional operations only.
# POLYBOT_LIFECYCLE_MODE=active
# POLYBOT_LIFECYCLE_MODE=close_only
# POLYBOT_EXCLUDED_CATEGORIES=sports,nba,soccer
