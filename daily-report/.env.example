# Polymarket Daily Reporter - 환경변수 예제
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# ============================================================
# 계좌 설정 (Account Configuration)
# ============================================================

# 계좌 1 - golden-apple
ACCOUNT_1_NAME=golden-apple
ACCOUNT_1_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# 계좌 2 - golden-banana
ACCOUNT_2_NAME=golden-banana
ACCOUNT_2_ADDRESS=0xabcdefabcdefabcdefabcdefabcdefabcdefabcd

# 계좌 3 - golden-cherry
ACCOUNT_3_NAME=golden-cherry
ACCOUNT_3_ADDRESS=0x9876543210fedcba9876543210fedcba98765432

# 계좌 4 - 두 번째 golden-apple
ACCOUNT_4_NAME=golden-apple
ACCOUNT_4_ADDRESS=0x1111111111111111111111111111111111111111

# 계좌 5 - 테스트 슬롯 (현재 golden-honeydew)
ACCOUNT_5_NAME=golden-eco
ACCOUNT_5_ADDRESS=0x2222222222222222222222222222222222222222

# 계좌 6 - 테스트 슬롯 (현재 golden-nectarine)
ACCOUNT_6_NAME=golden-fox
ACCOUNT_6_ADDRESS=0x3333333333333333333333333333333333333333

# 계좌 7 - 전략 슬롯
ACCOUNT_7_NAME=golden-lion
ACCOUNT_7_ADDRESS=0x4444444444444444444444444444444444444444

# 계좌 8 - 전략 슬롯
ACCOUNT_8_NAME=golden-tiger
ACCOUNT_8_ADDRESS=0x5555555555555555555555555555555555555555

# 계좌 9 - 전략 슬롯 (현재 golden-fig)
ACCOUNT_9_NAME=golden-wolf
ACCOUNT_9_ADDRESS=0x6666666666666666666666666666666666666666

# 계좌 10 - 전략 슬롯
ACCOUNT_10_NAME=golden-eagle
ACCOUNT_10_ADDRESS=0x7777777777777777777777777777777777777777

# 계좌 11 - 전략 슬롯
ACCOUNT_11_NAME=golden-bear
ACCOUNT_11_ADDRESS=0x8888888888888888888888888888888888888888

# 계좌 12 - 전략 슬롯
ACCOUNT_12_NAME=golden-cat
ACCOUNT_12_ADDRESS=0x9999999999999999999999999999999999999999

# 계좌 13 - 전략 슬롯
ACCOUNT_13_NAME=golden-dog
ACCOUNT_13_ADDRESS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# 계좌 14 - 전략 슬롯
ACCOUNT_14_NAME=golden-queen
ACCOUNT_14_ADDRESS=0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# 계좌 15 - 전략 슬롯
ACCOUNT_15_NAME=golden-king
ACCOUNT_15_ADDRESS=0xcccccccccccccccccccccccccccccccccccccccc

# 계좌 16 - 전략 슬롯
ACCOUNT_16_NAME=golden-fruit
ACCOUNT_16_ADDRESS=0xdddddddddddddddddddddddddddddddddddddddd

# Slack 계정 블록 표시 순서. 위 display name 전체의 정확한 순열이어야 합니다.
REPORT_ACCOUNT_ORDER='golden-apple (1),golden-banana,golden-cherry,golden-apple (2),golden-eagle,golden-fox,golden-cat,golden-dog,golden-queen,golden-king,golden-bear,golden-eco,golden-tiger,golden-fruit,golden-lion,golden-wolf'

# ============================================================
# Slack 알림 설정 (Slack Notification)
# ============================================================

# Slack Webhook URL
# https://api.slack.com/apps 에서 생성
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================
# Supabase 적재 설정 (서버 전용)
# ============================================================

# Settings → API Keys → Secret keys에서 확인합니다.
# sb_publishable_... 키를 넣으면 안 됩니다.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_only_key

# 별도 disk_monitor.py Jenkins job용 stable identity/timezone
STORAGE_MONITOR_HOST_ID=macmini-m5
STORAGE_MONITOR_TIMEZONE=Asia/Seoul

# 리포트 날짜 기준 시간대
REPORT_TIMEZONE=Asia/Seoul
DAILY_REPORT_LOG_FILE=daily_report_local.log

# 지갑 주소/비밀값을 제외한 일별 포지션 evidence SQLite
DAILY_EVIDENCE_DB=data/daily_evidence.sqlite3

# ============================================================
# 선택 사항 (Optional Settings)
# ============================================================

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 타임아웃 설정 (초)
API_TIMEOUT=30

# 재시도 횟수
MAX_RETRIES=3
