# Never put real credentials in this tracked example.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=3

LOG_LEVEL=INFO
POLYBOT_LIFECYCLE_MODE=active
POLYBOT_BUY_AMOUNT=5

# Optional override: Jenkins automatically uses the current user's equivalent
# owner-private path. Set "off" to disable, or use an absolute non-workspace
# path when both A/B jobs should share another location.
# POLYBOT_GAMMA_SHARED_CACHE_DIR=/absolute/owner-private/gamma-sweeps-v1

# Sole A/B treatment axis. Use one value per account/job.
# Arm A: POLYBOT_MIN_SURGE=0.02
# Arm B: POLYBOT_MIN_SURGE=0.05
POLYBOT_MIN_SURGE=0.02

# Both arms keep these values identical.
POLYBOT_EXPERIMENT_CAPITAL_USDC=150
# POLYBOT_MAX_DRAWDOWN_STOP=0.20
# POLYBOT_ENTRY_HOURS_MAX=72
# POLYBOT_ENTRY_PROB_MIN=0.85
# POLYBOT_ENTRY_PROB_MAX=0.93
# POLYBOT_STOP_PRICE=0.78
# POLYBOT_TAKE_PROFIT_PRICE=0.97
# POLYBOT_MIN_LIQUIDITY=10000
# POLYBOT_MIN_VOLUME_24H=10000
# Gamma cumulative lifetime-volume request envelope; distinct from volume24h.
# POLYBOT_ARCHIVE_MIN_CUMULATIVE_VOLUME=5000
# POLYBOT_MAX_POSITIONS=10

# Exceptional operations only.
# POLYBOT_LIFECYCLE_MODE=close_only
# POLYBOT_LIFECYCLE_MODE=archive_only
# POLYBOT_EXCLUDED_CATEGORIES=sports
