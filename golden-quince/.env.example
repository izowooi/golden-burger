# Secrets: keep real values only in an untracked .env or Jenkins Credentials Binding.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# Account-specific signing scheme: 1=proxy/Magic.Link, 3=POLY_1271.
POLYMARKET_SIGNATURE_TYPE=1

# Optional single sizing knob. The repository default is $5 (사전 등록 롤아웃 금액).
# Raising this value automatically raises liquidity, 24h volume, and exposure gates.
# 증액은 STRATEGY.md의 판정 기준을 통과한 뒤에만 한다.
POLYBOT_BUY_AMOUNT=5

# ── A/B/C 처치축: BUY 틱 반올림 방향 (이 전략의 전부) ───────────
#   passive — BUY 내림 (기본 처치군)
#   nearest — BUY 최근접 반올림 (대조군)
#   cross   — BUY 올림 (비용 상한 측정용)
# SELL은 안전한 청산을 위해 세 모드 모두 nearest로 고정된다.
# POLYBOT_EXECUTION_MODE=passive

# ── 사전 등록 kill switch (코드가 강제) ──────────────────────────
# 확정손익이 experiment_capital x max_drawdown_stop 이하가 되면 신규 진입 중단.
# POLYBOT_EXPERIMENT_CAPITAL_USDC=200
# POLYBOT_MAX_DRAWDOWN_STOP=0.20

# 격리 intent 자가 해제 (config_hash에 포함되도록 TradingConfig 필드로 승격됨)
# POLYBOT_INTENT_AUTORESOLVE=true

# Exceptional operations only; omit these during normal use.
# POLYBOT_LIFECYCLE_MODE=active
# POLYBOT_LIFECYCLE_MODE=close_only
# A/B/C의 signal horizon은 모두 24h로 고정한다. 비교 중 override하지 않는다.
# Exact Gamma tag match only; omit to include every category, including sports.
# POLYBOT_EXCLUDED_CATEGORIES=sports,nba,soccer
# POLYBOT_REJECT_SPORTS_WITHOUT_GAME_START=true
