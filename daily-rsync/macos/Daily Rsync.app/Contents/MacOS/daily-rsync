#!/bin/zsh
set -u

APP_CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
MARKER="$APP_CONTENTS/Resources/project-root.txt"

if [[ -n "${DAILY_RSYNC_PROJECT_ROOT:-}" && -d "$DAILY_RSYNC_PROJECT_ROOT" ]]; then
  PROJECT_ROOT="$DAILY_RSYNC_PROJECT_ROOT"
elif [[ -f "$MARKER" ]]; then
  PROJECT_ROOT="$(head -n 1 "$MARKER")"
else
  PROJECT_ROOT="$(cd "$APP_CONTENTS/../../.." && pwd)"
fi

alert() {
  /usr/bin/osascript -e "display alert \"Daily Rsync\" message \"$1\" as critical" >/dev/null
}

if [[ ! -d "$PROJECT_ROOT" || ! -f "$PROJECT_ROOT/pyproject.toml" ]]; then
  alert "프로젝트 폴더를 찾지 못했습니다: $PROJECT_ROOT"
  exit 1
fi
if [[ ! -x "$PROJECT_ROOT/daily-rsync-toggle.sh" ]]; then
  alert "Daily Rsync toggle script를 찾지 못했습니다: $PROJECT_ROOT"
  exit 1
fi
"$PROJECT_ROOT/daily-rsync-toggle.sh" start || exit $?

STATE_DIR="${DAILY_RSYNC_STATE_DIR:-/Volumes/daily-rsync-data/state}"
PID_FILE="$STATE_DIR/ui-server.pid"
SERVER_PID="$(head -n 1 "$PID_FILE" 2>/dev/null || true)"
if [[ "$SERVER_PID" != <-> ]]; then
  alert "Daily Rsync managed PID를 확인하지 못했습니다: $PID_FILE"
  exit 1
fi
while /bin/kill -0 "$SERVER_PID" 2>/dev/null; do
  /bin/sleep 5
done
