# Live only. Keep real values in Jenkins Credentials Binding or an untracked .env.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1

LOG_LEVEL=INFO
POLYBOT_LIFECYCLE_MODE=active
POLYBOT_SPORT_FAMILY=soccer
POLYBOT_BUY_AMOUNT=5
POLYBOT_MIN_LIQUIDITY=5000
POLYBOT_MIN_CUMULATIVE_VOLUME=5000
POLYBOT_MIN_VOLUME_24H=0
POLYBOT_MAX_POSITIONS=10
POLYBOT_MAX_EVENT_POSITIONS=1
POLYBOT_MAX_NEW_POSITIONS_PER_CYCLE=5
POLYBOT_MAX_EMERGENCY_SELLS_PER_CYCLE=10
POLYBOT_YES_ONLY=false

POLYBOT_ENTRY_PROB_MIN=0.60
POLYBOT_ENTRY_PROB_MAX=0.94
POLYBOT_MAX_SOURCE_MINUTE=10
POLYBOT_MIN_LEADER_MARGIN=0.005
POLYBOT_MAX_ENTRY_SPREAD=0.05
# Eco=0.03, Fruit/Grey=0.05; runtime job validation rejects any other value.
POLYBOT_TAKE_PROFIT_DELTA=0.03
POLYBOT_STOP_LOSS_DELTA=0.10
POLYBOT_LATE_EXIT_MINUTE=80
POLYBOT_LATE_PROFIT_FRACTION=0.50
POLYBOT_STOP_CUTOFF_MINUTE=80
POLYBOT_STOP_SELL_QUARANTINE_TIMEOUT_MINUTES=180

POLYBOT_EXPERIMENT_START_UTC=2026-08-30T00:00:00Z
POLYBOT_EXPERIMENT_END_UTC=2026-09-13T00:00:00Z
POLYBOT_EXPERIMENT_FOLLOWUP_END_UTC=2026-09-20T00:00:00Z
