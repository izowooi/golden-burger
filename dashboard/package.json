    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "typescript": "5.9.3",
    "wrangler": "4.123.0"
  },
